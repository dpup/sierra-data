{
  "name": "sierra-grid-site",
  "type": "module",
  "private": true,
  "description": "Astro source for data.sierragridteam.org \u2014 builds static files into ../site/dist (embedded by the Go server).",
  "scripts": {
    "dev": "pnpm run sync:maplibre && astro dev",
    "build": "pnpm run sync:maplibre && astro build",
    "preview": "astro preview",
    "screenshots": "pnpm run build && node screenshots/capture.mjs",
    "screenshots:only": "node screenshots/capture.mjs",
    "sync:maplibre": "node scripts/sync-maplibre.mjs"
  },
  "devDependencies": {
    "astro": "^7.4.7",
    "playwright": "^1.65.0"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.0"
  },
  "dependencies": {
    "maplibre-gl": "^6.17.0"
  }
}
