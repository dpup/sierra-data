---
// Shell.astro — the shared app shell, rendered STATICALLY at build time.
//
// The sidebar, top bar and footer are in the HTML at first paint, so the page
// never reflows ~244px after hydration. The only live bits — the source-health
// line, the UTC clock, the place switcher and the request-log drawer — are JS
// (assets/chrome.js) filling the static placeholders below.
//
// Layout is the broadsheet shell: a black 244px sidebar on ≥900px, and below
// that a black sticky top bar whose hamburger slides the same sidebar in as a
// drawer (app.css §15). Both render always; CSS decides which is visible, so
// there is no JS-driven layout swap and no flash.
//
// There is deliberately NO second header row on desktop. A context bar
// repeating "grid.v1 / Docs" duplicated the wordmark, the highlighted nav item
// and the clock, all of which the sidebar already carries — so the content
// column starts at the top of the viewport.
//
// There is also no global place switcher: the service currently covers one
// area, so a chrome-level control to choose between one option is furniture.
// Place scoping still works everywhere — `?place=` on any URL, resolved by
// assets/place.js — and the screens that are genuinely place-scoped (Map,
// Roads, History, Places) carry their own in-page selector. If a second AREA
// is ever configured, see the note at the foot of place.js.
//
// Page content is the default <slot/>. Pages pass a nav `current` key plus
// <title>/description; page-scoped CSS goes in a `head` slot (use is:global for
// rules that target runtime-built rows).

interface Props {
  current: string;
  title: string;
  description: string;
}
const { current, title, description } = Astro.props;

const NAV = [
  { key: 'home', label: 'Grid Info', href: '/', hint: '/api/v1', group: 'OVERVIEW', crumb: 'The Grid' },
  { key: 'events', label: 'Events', href: '/events', hint: '/events', group: 'EXPLORE', crumb: 'Events' },
  { key: 'map', label: 'Map', href: '/map', hint: '/map', group: 'EXPLORE', crumb: 'Map' },
  { key: 'roads', label: 'Roads', href: '/roads', hint: '/roads', group: 'EXPLORE', crumb: 'Roads' },
  { key: 'mesh', label: 'Mesh', href: '/mesh', hint: '/mesh', group: 'EXPLORE', crumb: 'Mesh' },
  { key: 'places', label: 'Places', href: '/places', hint: '/places', group: 'EXPLORE', crumb: 'Places' },
  { key: 'sources', label: 'Sources', href: '/sources', hint: '/sources', group: 'EXPLORE', crumb: 'Sources' },
  { key: 'history', label: 'History', href: '/history', hint: '/history', group: 'EXPLORE', crumb: 'History' },
  { key: 'docs', label: 'Docs', href: '/docs', hint: '/api/v1 ref', group: 'REFERENCE', crumb: 'Docs' },
  { key: 'mcp', label: 'MCP', href: '/mcp-guide', hint: 'for agents', group: 'REFERENCE', crumb: 'MCP' },
];
const GROUPS = ['OVERVIEW', 'EXPLORE', 'REFERENCE'];
const here = (NAV.find((n) => n.key === current) || {}).crumb || 'The Grid';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <!-- Preload only the faces above the fold: mono/sans body + the two Archivo
       display weights. More preloads cost more than the FOUT they save. -->
  <link rel="preload" href="/lib/fonts/ibm-plex-mono-400.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/lib/fonts/ibm-plex-sans-400.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/lib/fonts/archivo-800.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/lib/fonts/archivo-900.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/assets/app.css" />
  <slot name="head" />
</head>
<body>
<div class="app">
  <aside class="sidebar" id="sidebar">
    <a class="brand-block" href="/">
      <div class="brand-line">
        <span class="brand-name">THE GRID</span>
        <span class="brand-sub">S.I.E.R.R.A</span>
      </div>
      <div class="brand-host">data.sierragridteam.org</div>
    </a>

    <div class="health-chip">
      <div class="health-row">
        <span class="dot st-OK live" id="health-dot"></span>
        <span id="health-text">checking sources…</span>
      </div>
      <div class="health-sub"><span id="sidebar-clock">––:––:––Z</span> · read-only · no key</div>
    </div>

    <nav class="nav" aria-label="Sections">
      {GROUPS.map((g) => (
        <>
          <div class="nav-group-label">{g}</div>
          {NAV.filter((n) => n.group === g).map((item) => (
            <a
              class={'nav-item' + (item.key === current ? ' current' : '')}
              href={item.href}
              aria-current={item.key === current ? 'page' : undefined}
            >
              <span>{item.label}</span><span class="hint">{item.hint}</span>
            </a>
          ))}
        </>
      ))}
    </nav>

    <div class="sidebar-foot">
      <div>grid.v1 · schema 2026-07</div>
      <div><span id="side-req-count">0</span> request(s) this page</div>
    </div>
  </aside>

  <div class="content">
    <!-- Mobile chrome: CSS shows this only under 900px (app.css §15). -->
    <div class="topbar">
      <button class="topbar-burger" id="nav-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="sidebar">≡</button>
      <span class="topbar-here">{here}</span>
      <span class="topbar-right">
        <span class="dot st-OK live" id="health-dot-m"></span><span id="health-text-m">checking…</span>
      </span>
    </div>

    <!-- A full-bleed band renders HERE, outside main, for the same reason the
         footer does: main is a centred 1280px column, so a child of it cannot
         reach past 1280px however far its negative margins break out of the
         padding. The deck did exactly that and stopped short on wide screens,
         with paper down both sides of a band whose whole job is to run edge to
         edge. Its own .deck-inner re-establishes the 1280px measure, so the
         text still lines up with main's. -->
    <slot name="deck" />

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <details class="request-log">
          <summary>View the <span class="request-count" id="req-count">0</span> request(s) behind this page</summary>
          <div class="request-log-list" id="req-log-list"></div>
        </details>
        <p class="footer-line">Signal Integrity &amp; Emergency Radio Response Alliance · P.O. Box 2071, Murphys, CA 95247 · a volunteer 501(c)(3). Every value on this site is a browser fetch of the public /api/v1 API — replay any of them yourself.</p>
      </div>
    </footer>
  </div>
</div>

<!-- Live shell behaviors: fill the static placeholders above. is:inline keeps
     this as a plain external module (Astro won't re-bundle it), identical to how
     the per-page scripts load their existing modules from /assets. -->
<script is:inline type="module" src="/assets/chrome.js"></script>
</body>
</html>
