---
import Shell from '../layouts/Shell.astro';
import PageHead from '../components/PageHead.astro';
import GetChip from '../components/GetChip.astro';
import FilterGroup from '../components/FilterGroup.astro';
---
<Shell
  current="history"
  title="History · The Grid"
  description="Archive browser over GET /api/v1/history — the chronological, replayable feed of event revisions for after-action review."
>
  <style is:global slot="head">
    /* Page-local: the day-separator row inside the revision feed, and the
       results footer. The filters are the shared .filter-set (app.css §14).
       All colors/sizes come from app.css tokens. */
    /* Day break in the revision feed: a mono subhead between runs of records.
       It sits ON the paper rather than in a tinted band — the feed is a list of
       records, and a filled row would read as one of them. */
    .day-sep {
      font-family: var(--font-mono);
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.11em;
      color: var(--text-tertiary);
      border-bottom: 1px solid var(--rule);
      padding: 16px 0 5px;
    }
    /* The first separator opens the feed, so it owns the top rule instead of
       .rec-list's — otherwise the two stack into a double line. */
    .rec-list > .day-sep:first-child { padding-top: 8px; }
    .results-foot {
      display: flex;
      align-items: center;
      gap: 16px;
      /* The pager is not part of the last row — it needs to read as the foot of
         the list, not as another entry in it. */
      margin: var(--space-sub) 0 24px;
    }
  </style>

  <PageHead kicker="Events · revision archive" title="History">
    <p class="lead">The same events, one row per revision.</p>
    <GetChip slot="badges" path="/api/v1/history" />
  </PageHead>

  <p class="rail-caption">
    <b>Filters</b>= query params of <code class="inline">/api/v1/history</code>
  </p>


  <!-- The shared filter set: one facet per /api/v1/history query parameter.
       Unlike Events these do NOT refetch on change — a date-range query over the
       revision archive is expensive enough that firing one per chip would be
       hostile, so this is the one filter set with an explicit Apply. -->
  <div class="filter-set">
    <FilterGroup param="layer" note="any of · empty = all layers"
                 control="grid-chip-row" id="hist-layers" mode="multi" />

    <div class="filter-row">
      <FilterGroup param="place">
        <grid-menu id="hist-place" trigger-label="any place" aria-label="Scope to a place"></grid-menu>
      </FilterGroup>

      <FilterGroup param="from">
        <input type="datetime-local" id="hist-from" class="filter-input" aria-label="from">
      </FilterGroup>

      <FilterGroup param="to">
        <input type="datetime-local" id="hist-to" class="filter-input" aria-label="to">
      </FilterGroup>

      <FilterGroup param="page_size">
        <grid-menu id="hist-size" trigger-label="default" aria-label="Page size"></grid-menu>
      </FilterGroup>

    </div>
  </div>

  <!-- THE RAIL. The request, the response shape and the standing caveat are
       facts about the WHOLE page, not steps in reading it — stacked in the flow
       they were three blocks of prose between the filters and the archive, each
       leaving half the column empty beside it. In the rail they are still there
       400 revisions down, which is exactly when a reader wants the shape and
       the clock caveat. -->
  <div class="with-rail">
    <div class="rail-main">
      <p class="section-intro intro-full">
        <strong>These are the events from the <a href="/events">Events browser</a>, unrolled.</strong>
        That screen shows each event once, as it stands now; this one shows every revision it has
        passed through — so you read the arc, not the current state. A row is a revision, carries
        its <code class="inline">rev n</code>, and opens the same record its counterpart on Events
        opens. Absence is recorded as deliberately as onset: "nothing here now" is a fact you can
        trace to the revision that made it true, never inferred from an empty screen.
      </p>

      <!-- The archive is a list of records, not a spreadsheet: the same .rec row
           as Events, Roads and the front-page feed, carrying `rev {n}` in its
           meta line. -->
      <div id="hist-feed" class="rec-list" aria-live="polite"></div>
    </div>

    <aside class="page-rail" aria-label="About this query">
      <div class="rail-block">
        <div class="rail-label">Request</div>
        <div id="hist-query" class="req-echo" aria-label="Request behind these results"></div>
      </div>

      <div class="rail-block">
        <div class="rail-label">Returns</div>
        <div class="rail-mono">
          grid.v1.EventRevisionList<br />
          revisions[].&#123;<br />
          <span class="indent">revision,</span>
          <span class="indent">observedAt,</span>
          <span class="indent">ingestedAt,</span>
          <span class="indent">event &#125;</span>
        </div>
        <p class="muted small">RFC&nbsp;3339 · newest first · pages by
          <code class="inline">next_page_token</code> · days grouped in UTC</p>
        <p class="muted small"><code class="inline">from</code>/<code class="inline">to</code> are
          entered in your local time and sent as UTC — the echoed request shows exactly what
          went over the wire.</p>
      </div>

      <!-- A measured caveat, not a theoretical one: mesh nodes stamp their own
           adverts and their clocks drift, so the ordering key can be in the
           future. It is the one place the archive looks wrong, so it stays on
           screen for as long as the archive does. -->
      <div class="rail-block">
        <div class="rail-label alert">Clock caveat</div>
        <p>
          Ordering is by <code class="inline">observedAt</code>, which is upstream-stamped. Mesh
          nodes timestamp their own adverts from an unsynchronized clock, so a
          <code class="inline">MESH</code> revision can carry a future time and sort above newer
          records. Reported verbatim — we do not rewrite it. For when <em>this service</em>
          learned something, read <code class="inline">ingestedAt</code>.
        </p>
      </div>
    </aside>
  </div>

  <div class="results-foot">
    <button type="button" id="hist-more" hidden>Load more</button>
    <span id="hist-status" class="loading">Loading…</span>
  </div>

  <script is:inline type="module">
    import { initHistoryPage } from '/assets/pages/history.js';
    initHistoryPage();
  </script>
</Shell>
