---
import Shell from '../layouts/Shell.astro';
import PageHead from '../components/PageHead.astro';
import GetChip from '../components/GetChip.astro';
---
<Shell
  current="history"
  title="History · The Grid"
  description="Archive browser over GET /v1/history — the chronological, replayable feed of event revisions for after-action review."
>
  <style is:global slot="head">
    /* Page-local: the layer checkbox group, the request line, and the
       day-separator row inside the revision table. All colors/sizes come
       from app.css tokens — nothing here overrides the design system. */
    .layer-checks {
      display: flex;
      flex-wrap: wrap;
      gap: 4px 18px;
      max-width: 34rem;
    }
    .layer-check {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      text-transform: none;
      letter-spacing: 0;
      font-size: 12.5px;
      color: var(--text);
      cursor: pointer;
      white-space: nowrap;
    }
    .query-line {
      display: flex;
      align-items: baseline;
      gap: 12px;
      font-family: var(--font-mono);
      font-size: 12px;
      margin: 2px 0 14px;
      overflow-x: auto;
      white-space: nowrap;
    }
    /* Day break inside the revision table: a full-width subhead row. */
    tr.day-sep td {
      background: var(--bg-header);
      color: var(--text-fainter);
      font-family: var(--font-mono);
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.11em;
      padding: 7px 20px;
      white-space: nowrap;
    }
    .data-table td.rev-num { color: var(--text-faint); }
    .data-table td.rev-status { color: var(--text-faint); }
    .results-foot {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 24px;
    }
  </style>

  <PageHead title="History">
    <p class="lead">
      The after-action record. Every state transition an event passes through —
      a wildfire's acreage revised upward, a warning escalated, and the
      <strong>all-clear written the moment an event leaves its feed</strong> — is
      stored as its own immutable revision. This is the chronological, replayable
      archive over a time range: absence is recorded as deliberately as onset, so
      "nothing here now" is a fact you can trace back to the revision that made it
      true — never inferred from an empty screen.
    </p>
    <GetChip slot="badges" path="/v1/history" />
  </PageHead>

  <p class="muted small" style="margin-top:12px;max-width:96ch;">
    <code class="inline">GET /v1/history?place=&amp;layer=&amp;from=&amp;to=</code>
    returns every stored revision of every event in the range, newest first — the
    snake_case protojson of <code class="inline">grid.v1.EventRevisionList</code>
    (<code class="inline">revisions[].&#123;revision, observed_at, ingested_at, event&#125;</code>).
    Filters map 1:1 to the query parameters and live in this page's URL, so a
    date-range view of an incident's whole arc is a shareable permalink; paging
    follows <code class="inline">next_page_token</code>. Timestamps are RFC&nbsp;3339;
    days are grouped in UTC.
  </p>

  <!-- Filters: each control is one /v1/history query parameter. -->
  <div class="filters">
    <label for="hist-place">place</label>
    <div class="fcell"><select id="hist-place"></select></div>

    <label id="hist-layers-label">layer<span class="lbl-note">any of · empty = all layers</span></label>
    <div id="hist-layers" class="layer-checks" role="group" aria-labelledby="hist-layers-label"></div>

    <label for="hist-from">from<span class="lbl-note">local time</span></label>
    <div class="fcell"><input type="datetime-local" id="hist-from"></div>

    <label for="hist-to">to<span class="lbl-note">local time · blank = now</span></label>
    <div class="fcell"><input type="datetime-local" id="hist-to"></div>

    <label for="hist-size">page_size</label>
    <div class="fcell"><select id="hist-size"></select></div>

    <label></label>
    <div class="fcell fcell-actions"><button type="button" id="hist-apply">Apply</button></div>
  </div>

  <div id="hist-query" class="query-line" aria-label="Request behind these results"></div>

  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th style="width:150px">Observed</th>
          <th style="width:96px">Severity</th>
          <th style="width:132px">Layer</th>
          <th class="num" style="width:64px">Rev</th>
          <th style="width:96px">Status</th>
          <th>Event</th>
        </tr>
      </thead>
      <tbody id="hist-feed" aria-live="polite"></tbody>
    </table>
  </div>

  <div class="results-foot">
    <button type="button" id="hist-more" hidden>Load more</button>
    <span id="hist-status" class="loading">Loading…</span>
  </div>

  <script is:inline type="module">
    import { initHistoryPage } from '/assets/pages/history.js';
    initHistoryPage();
  </script>
</Shell>
