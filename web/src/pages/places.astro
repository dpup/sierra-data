---
import Shell from '../layouts/Shell.astro';
import PageHead from '../components/PageHead.astro';
import SectionHead from '../components/SectionHead.astro';
import GetChip from '../components/GetChip.astro';
---
<Shell
  current="places"
  title="Places · The Grid"
  description="Place directory for the Grid: areas, counties, towns, evacuation zones, corridors — with geometry on a map and a lat/lng and address resolve tester."
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/lib/maplibre-gl.css" />
    <script is:inline src="/lib/maplibre-gl.js" defer></script>
  </Fragment>

  <PageHead kicker="grid.v1 · place directory" title="Places">
    <p class="lead">
      Every event, alert, and summary in the Grid is scoped to a
      <em>place</em> — an area, county, town, evacuation zone, or highway corridor.
      Places are addressable by slug (<code class="inline">ebbetts-pass</code>) or by
      <code class="inline">kind:slug</code> id (<code class="inline">county:calaveras-county</code>),
      and <code class="inline">/resolve</code> turns a lat·lng or a street address into
      the places that contain it, <strong>most-specific first</strong>. This is the live
      directory, the per-place geometry, and the resolve tester — every row is a browser
      fetch you can replay yourself.
    </p>
  </PageHead>

  <!-- endpoints reference -->
  <div class="section-gap"></div>
  <SectionHead heading="Three ways in" cap="directory · detail · resolve" />
  <section class="card" aria-labelledby="endpoints-h">
    <h3 id="endpoints-h" style="margin-top:0">Endpoints</h3>
    <div style="display:flex;flex-direction:column;gap:16px;margin-top:12px;">
      <div>
        <GetChip path="/api/v1/places" />
        <p class="prose" style="margin:8px 0 0;font-size:13px;">
          The directory. Filter by <code class="inline">kind</code>
          (AREA, COUNTY, TOWN, EVAC_ZONE, CORRIDOR, SITE) or <code class="inline">q</code>
          (name search). <a href="/api/v1/places?kind=COUNTY">Try&nbsp;?kind=COUNTY</a>.
        </p>
      </div>
      <div>
        <GetChip path="/api/v1/places/{place}" />
        <p class="prose" style="margin:8px 0 0;font-size:13px;">
          One place by slug or id — geometry (base64 GeoJSON in
          <code class="inline">geometry.geojson</code>), centroid, bbox, and
          <code class="inline">parentId</code>. <a href="/api/v1/places/ebbetts-pass">Try&nbsp;/ebbetts-pass</a>.
        </p>
      </div>
      <div>
        <GetChip path="/api/v1/places:resolve" />
        <p class="prose" style="margin:8px 0 0;font-size:13px;">
          <code class="inline">?lat=&amp;lng=</code> or <code class="inline">?address=</code>
          &rarr; the containing places, most-specific first (SITE&nbsp;&rarr;&nbsp;AREA).
          <a href="/api/v1/places:resolve?lat=38.0679&amp;lng=-120.5385">Try&nbsp;a&nbsp;point</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- selected place detail (hidden until a place is chosen) -->
  <section id="place-view" hidden aria-labelledby="place-name">
    <p class="small"><a href="/places">&larr; All places</a></p>
    <h2 id="place-name">Loading&hellip;</h2>
    <div id="place-detail"><span class="loading">Loading place&hellip;</span></div>
  </section>

  <!-- directory grouped by kind -->
  <section id="directory-view" aria-labelledby="directory-h">
    <SectionHead cap="grouped by kind · most-specific to broadest">
      <Fragment slot="left">
        <h2 id="directory-h">Directory</h2>
        <GetChip path="/api/v1/places" />
      </Fragment>
    </SectionHead>
    <div id="directory"><span class="loading">Loading /api/v1/places&hellip;</span></div>
  </section>

  <!-- shared map + resolve tester -->
  <section id="resolve-section" aria-labelledby="resolve-h">
    <div class="section-gap"></div>
    <SectionHead cap="click the map · or enter a point / address">
      <Fragment slot="left">
        <h2 id="resolve-h">Map &amp; resolve</h2>
        <GetChip path="/api/v1/places:resolve" />
      </Fragment>
    </SectionHead>
    <p id="map-hint" class="small muted">Click anywhere on the map to resolve that point to its containing places.</p>
    <div id="map" class="map-canvas" role="application" aria-label="Map. Click a point to resolve it to containing places."></div>
    <div class="filter-bar">
      <form id="point-form" class="row">
        <div class="field">
          <label for="lat-input">lat</label>
          <input id="lat-input" name="lat" size="10" inputmode="decimal" autocomplete="off" placeholder="38.0679">
        </div>
        <div class="field">
          <label for="lng-input">lng</label>
          <input id="lng-input" name="lng" size="10" inputmode="decimal" autocomplete="off" placeholder="-120.5385">
        </div>
        <button type="submit">Resolve point</button>
      </form>
      <form id="address-form" class="row">
        <div class="field">
          <label for="address-input">address</label>
          <input id="address-input" name="address" size="34" autocomplete="off" placeholder="1225 Main St, Angels Camp">
        </div>
        <button type="submit">Resolve address</button>
      </form>
    </div>
    <div id="resolve-results"></div>
  </section>

  <script is:inline type="module">
    import { initPlacesPage } from '/assets/pages/places.js';
    initPlacesPage();
  </script>
</Shell>
