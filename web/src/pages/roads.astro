---
import Shell from '../layouts/Shell.astro';
import PageHead from '../components/PageHead.astro';
import SectionHead from '../components/SectionHead.astro';
import FilterGroup from '../components/FilterGroup.astro';
---
<Shell
  current="roads"
  title="Roads · The Grid"
  description="Roads split across two idioms: road incidents are events (GET /api/v1/events?layer=road_incident), while road conditions — congestion and chain control — are not events and exist only as the road_segment and chain_control map layers. Each layer reports its own source status honestly."
>
  <Fragment slot="head">
    <style is:global>
      /* Page-local: the per-section source-status line and the roads tables'
         phone reflow. Everything else is a shared primitive — .filter-set,
         .rec (via format.js recordRow), .data-table, .notice, .loud-banner.
         No colors are defined here; they all resolve to app.css tokens. */

      /* Source-status line: the honest header above each condition table —
         a status dot, when it was generated, its attribution, and the exact
         curl that produced it. */
      /* In the rail it is a stack, not a row: dot + freshness + attribution,
         then the copyable URL under them. */
      .rd-status-line { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin: 0; }
      .rd-curl { width: 100%; margin-top: 8px; }

      /* The road cell carries a headline plus, when a road is not fully open,
         the AI status explanation beneath it. Table cells are mono site-wide
         (app.css: values are mono), but this is a written sentence, not a
         value — so it takes the prose face back. */
      .rd-explain {
        font-family: var(--font-sans); margin-top: 3px;
        max-width: var(--measure-tight); white-space: normal;
      }
      .rd-delay { color: var(--st-STALE); }

      /* Status / chain-level badge. Filled on the paper ramp, same treatment as
         .sev-badge, but keyed on road status rather than severity. */
      .rd-badge {
        display: inline-block; font-family: var(--font-mono); font-size: 9.5px; font-weight: 700;
        letter-spacing: 0.1em; text-transform: uppercase; padding: 2px 7px; line-height: 1.4;
        color: #fff; background: var(--text-tertiary); white-space: nowrap;
      }
      .rd-open  { background: var(--st-OK); }
      .rd-warn  { background: var(--sev-MODERATE); }
      .rd-warn2 { background: var(--sev-SEVERE); }
      .rd-bad   { background: var(--st-UNAVAILABLE); }
      .rd-unknown { background: var(--text-tertiary); }

      /* Phones: these tables carry more columns than a 390px screen holds, so
       * travel time, delay and distance would scroll off unseen. Reflow each row
       * into a stacked card, every cell captioned by its column via data-label
       * (set in roads.js), so no value is lost to a sideways scroll.
       * Scoped to .rd-table — .data-table is used site-wide. */
      @media (max-width: 640px) {
        .data-table.rd-table thead { display: none; }
        .data-table.rd-table,
        .data-table.rd-table tbody,
        .data-table.rd-table tr,
        .data-table.rd-table td { display: block; width: 100%; }
        .data-table.rd-table tr { border-bottom: 1px solid var(--rule); padding: 8px 0; }
        .data-table.rd-table tr:last-child { border-bottom: none; }
        .data-table.rd-table td { border: none; padding: 3px 0; white-space: normal; }
        .data-table.rd-table td + td { padding-left: 0; }
        .data-table.rd-table td.num { text-align: left; white-space: normal; }
        .data-table.rd-table td[data-label]::before {
          content: attr(data-label); display: block; margin-bottom: 1px;
          font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.11em;
          text-transform: uppercase; color: var(--text-tertiary);
        }
      }
    </style>
  </Fragment>

  <PageHead kicker="Road conditions" title="Roads">
    <p class="lead">Road incidents are events. Road conditions are not.</p>
  </PageHead>

  <p class="rail-caption">
    <b>Place</b>scopes every section below · incidents arrive through
    <code class="inline">/events?layer=road_incident</code>; conditions are projections of live
    state, served only as the <code class="inline">road_segment</code> and
    <code class="inline">chain_control</code> map layers
  </p>

  <div class="filter-set">
    <FilterGroup param="place">
      <grid-menu id="rd-place" trigger-label="loading places…" aria-label="Scope to a place"></grid-menu>
    </FilterGroup>
  </div>

  <div id="rd-errors"></div>

  <!-- ================= INCIDENTS — these ARE events ================= -->
  <SectionHead cap="severity · headline · id">
    <Fragment slot="left">
      <h2 id="rd-inc-h">Incidents</h2>
    </Fragment>
  </SectionHead>
  <div class="with-rail">
    <div class="rail-main">
      <div id="rd-inc"></div>
    </div>
    <aside class="page-rail" aria-label="About the incident feed">
      <div class="rail-block">
        <div class="rail-label">What this is</div>
        <p>
          CHP and Caltrans incidents on these corridors, each AI-enhanced into a readable
          summary with an impact-driven severity.
        </p>
        <p>
          These are stored events — the same records
          <code class="inline">/events?layer=road_incident</code> returns — so a row opens the
          full record and its revision history.
        </p>
      </div>
      <div class="rail-block">
        <div class="rail-label">Source</div>
        <div id="rd-inc-status" class="rd-status-line"></div>
      </div>
    </aside>
  </div>

  <!-- ================= CONDITIONS — these are NOT events ================= -->
  <SectionHead class="section-gap" heading="Road segments" get="…/map/road_segment.geojson" cap="road · status · congestion · travel · delay · distance" />
  <div class="with-rail">
    <div class="rail-main">
      <div id="rd-seg"></div>
    </div>
    <aside class="page-rail" aria-label="About road segments">
      <div class="rail-block">
        <div class="rail-label">What this is</div>
        <p>
          One row per monitored road, live from Google Routes travel times and Caltrans status.
          Delay is against the road's free-flow duration; status is AI-determined, with the
          explanation shown when a road is not fully open.
        </p>
        <p>
          A segment is <strong>baseline state</strong> — it never appears in
          <code class="inline">/events</code>.
        </p>
      </div>
      <div class="rail-block">
        <div class="rail-label">Source</div>
        <div id="rd-seg-status" class="rd-status-line"></div>
      </div>
    </aside>
  </div>

  <SectionHead class="section-gap" heading="Chain control" get="…/map/chain_control.geojson" cap="level · highway · direction · note" />
  <div class="with-rail">
    <div class="rail-main">
      <div id="rd-chain"></div>
    </div>
    <aside class="page-rail" aria-label="About chain control">
      <div class="rail-block">
        <div class="rail-label">What this is</div>
        <p>
          Active chain requirements from Caltrans — R1 chains or 4WD · R2 chains except 4WD ·
          R3 chains required, all vehicles.
        </p>
      </div>
      <div class="rail-block">
        <div class="rail-label alert">Empty is a clean report</div>
        <p>
          It means the source reported no controls — not a failed feed. A failed feed says
          <span class="mono">UNAVAILABLE</span> in the source block above.
        </p>
      </div>
      <div class="rail-block">
        <div class="rail-label">Source</div>
        <div id="rd-chain-status" class="rd-status-line"></div>
      </div>
    </aside>
  </div>

  <p class="section-intro section-gap">
    To read those two condition layers as geometry — with their
    <code class="inline">metadata</code> block beside the map — use the
    <a href="/map">Map</a> screen.
  </p>

  <script is:inline type="module">
    import { initRoadsPage } from '/assets/pages/roads.js';
    initRoadsPage();
  </script>
</Shell>
