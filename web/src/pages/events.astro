---
import Shell from '../layouts/Shell.astro';
import PageHead from '../components/PageHead.astro';
import GetChip from '../components/GetChip.astro';
// The detail column mounts the SHARED renderer, so it needs the renderer's own
// stylesheet + MapLibre — exactly what the /event page loads.
import EventDetailStyles from '../components/EventDetailStyles.astro';
---
<Shell
  current="events"
  title="Events · The Grid"
  description="Event explorer over GET /api/v1/events — the cross-layer query of every discrete occurrence the Grid tracks, with filters that map 1:1 to the endpoint's parameters and a URL that is the shareable permalink."
>
  <EventDetailStyles slot="head" />

  <style is:global slot="head">
    /* Page-local: the query bar, the pill filter rows, and the two-column
       results + JSON inspector layout. Every color/size resolves to an
       app.css token — nothing here overrides the design system. */

    /* .fcell / .fcell-actions / .pill-row / .lbl-note are shared components in app.css. */
    .fspacer { display: block; }

    /* since / page_size: real parameters, but not what anyone filters by first. */
    .fmore { font-family: var(--font-mono); font-size: 11px; }
    .fmore summary {
      cursor: pointer; color: var(--text-muted-p); list-style: none;
      letter-spacing: 0.04em; padding: 4px 0;
    }
    .fmore summary::-webkit-details-marker { display: none; }
    .fmore summary::before { content: "+ "; color: var(--text-tertiary); }
    .fmore[open] summary::before { content: "— "; }
    .fmore-body {
      display: flex; align-items: center; gap: 8px 14px; flex-wrap: wrap;
      padding: 8px 0 2px;
    }

    /* The echoed request, per spec: mono, muted, directly under the rule. */
    .echo-query { display: flex; align-items: baseline; gap: 10px; }
    .echo-query .method { color: var(--signal); font-weight: 700; }
    .echo-query #ev-url { overflow-wrap: anywhere; white-space: normal; color: var(--text-primary); }
    .echo-query .copy-btn { margin-left: auto; flex: none; }

    /* Results: a single full-width list until a record is selected, then a
       narrow list beside the full record. Under 900px the two SWAP — the
       detail replaces the list — so a phone never renders a 380px column of
       truncated headlines beside a cramped record. */
    /* CONTAINER query, not a viewport media query. The results grid lives
       inside .content, which is inset by the 244px sidebar — so a 920px
       VIEWPORT leaves only ~600px here, and a viewport-keyed two-column rule
       collapsed the detail column to ~213px of clipped values. Keying on the
       grid's own width is the only measurement that is actually true. */
    /* The container must be an ANCESTOR of what it styles — an element cannot
       query its own container, which silently makes the rule never match. */
    #ev-results { container-type: inline-size; container-name: results; }
    .results-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px; align-items: start; }
    @container results (min-width: 760px) {
      .results-grid.has-selection { grid-template-columns: minmax(280px, 380px) minmax(0, 1fr); }
    }
    .results-col { min-width: 0; }
    .detail-col { min-width: 0; }
    .results-grid.has-selection .detail-col {
      position: sticky; top: 20px; align-self: start;
      max-height: calc(100vh - 40px); overflow: auto;
    }
    .ev-back {
      display: inline-block; margin-bottom: 12px; font-family: var(--font-mono);
      font-size: 11px; letter-spacing: 0.06em;
    }
    /* Any `display` rule beats the [hidden] attribute's UA `display:none`, so a
       hidden-by-default control needs this explicitly or it shows everywhere. */
    .ev-back[hidden] { display: none; }
    #ev-list { border-top: 1px solid var(--rule); }

    .results-foot { display: flex; align-items: center; gap: 16px; margin-top: 14px; margin-bottom: 8px; }

    /* Below the container threshold there is only room for one pane, so the
       detail REPLACES the list (events.js adds .narrow-detail). */
    @container results (max-width: 759.98px) {
      .results-grid.has-selection .detail-col { position: static; max-height: none; overflow: visible; }
      .results-grid.narrow-detail .results-col { display: none; }
    }
    @media (max-width: 900px) {
      .results-grid.has-selection .detail-col { position: static; max-height: none; overflow: visible; }
    }
  </style>

  <PageHead kicker="grid.v1 · event explorer" title="Events">
    <p class="lead">
      Every discrete occurrence the Grid tracks — wildfire,
      evacuation, weather alert, earthquake, road incident, and the rest — is
      reachable through <strong>one endpoint</strong>. The filters below map
      1:1 onto the query parameters of
      <code class="inline">GET /api/v1/events</code>; results are the camelCase
      protojson of <code class="inline">grid.v1.EventList</code>, server-sorted
      <strong>severity-first, then newest-first</strong>. This page's whole
      filter state lives in its URL, so any view you compose here is a
      shareable permalink — <strong>you can replay the exact request
      yourself.</strong>
    </p>
    <GetChip slot="badges" path="/api/v1/events" />
  </PageHead>

  <!-- Filter bar (design spec §2): labelled chip groups above a 3px rule, with
       the resulting GET printed beneath. Every control refetches on change —
       there is no Apply step, so the chips ARE the query. `since` and
       `page_size` sit in a disclosure: they complete the 1:1 mapping onto the
       endpoint's parameters without putting two more rows in front of everyone. -->
  <div class="filters">
    <label for="ev-place">place</label>
    <div class="fcell"><select id="ev-place"></select></div>

    <label id="ev-layers-label">layer<span class="lbl-note">any of · empty = all layers</span></label>
    <div id="ev-layers" class="pill-row" role="group" aria-labelledby="ev-layers-label"></div>

    <label id="ev-sev-label">severity_min<span class="lbl-note">inclusive floor</span></label>
    <div id="ev-sev" class="pill-row" role="group" aria-labelledby="ev-sev-label"></div>

    <label id="ev-status-label">status<span class="lbl-note">default ACTIVE + SCHEDULED</span></label>
    <div id="ev-status" class="pill-row" role="group" aria-labelledby="ev-status-label"></div>

    <span class="fspacer" aria-hidden="true"></span>
    <div class="fcell fcell-actions">
      <details class="fmore">
        <summary>since &amp; page_size</summary>
        <div class="fmore-body">
          <label for="ev-since">since<span class="lbl-note">local time</span></label>
          <input type="datetime-local" id="ev-since">
          <label for="ev-size">page_size</label>
          <select id="ev-size"></select>
        </div>
      </details>
      <button type="button" id="ev-reset">Reset</button>
    </div>
  </div>

  <!-- The exact request behind the results below. -->
  <div class="echo-query">
    <span class="method">GET</span> <span id="ev-url"></span>
    <button type="button" id="ev-copyurl" class="copy-btn">copy curl</button>
  </div>

  <div id="ev-errors"></div>

  <!-- Record list (left) + the full record (right). The right column is rendered
       by renderEventDetail() — the SAME renderer as the /event permalink page —
       so the browser and the permalink can never show a record differently.
       Under 900px the two swap: selecting replaces the list (see events.js). -->
  <div id="ev-results">
  <div class="results-grid" id="ev-grid">
    <div class="results-col" id="ev-list-col">
      <div id="ev-list" aria-live="polite"></div>
      <div id="ev-empty"></div>
      <div class="results-foot">
        <button type="button" id="ev-more" hidden>Load more</button>
        <span id="ev-status-line" class="loading">Loading…</span>
      </div>
    </div>

    <div class="detail-col" id="ev-detail-col" hidden>
      <button type="button" id="ev-back" class="ev-back" hidden>&larr; back to list</button>
      <div id="ev-detail"></div>
    </div>
  </div>
  </div>

  <!-- renderEventDetail draws each record's geometry when MapLibre is present;
       without it the detail column silently degrades to bbox/centroid text. -->
  <script is:inline src="/lib/maplibre-gl.js"></script>
  <script is:inline type="module">
    import { initEventsPage } from '/assets/pages/events.js';
    initEventsPage();
  </script>
</Shell>
