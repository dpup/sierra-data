---
import Shell from '../layouts/Shell.astro';
// The reference body is a large, fully-static HTML document dense with literal
// braces (JSON snippets, {place}/{id} path templates). Importing it raw and
// injecting via set:html keeps it verbatim and avoids Astro trying to evaluate
// those braces as expressions — the pragmatic choice for a static doc page.
import docsBody from '../partials/docs-body.html?raw';
---
<Shell
  current="docs"
  title="API Reference · The Grid"
  description="Reference for the Grid /api/v1 API: endpoints, the Event envelope, severity scale, place id scheme, GeoJSON layer contract, and the evacuation fail-loud contract."
>
  <style is:global slot="head">
    /* Page-local structure for the reference. app.css is the design system and
       owns every color/token; these rules only add docs-specific layout on top
       of it — no new palette, only the locked custom properties. */

    /* Endpoint heading: a GET /api/v1/... chip standing in for the h3, matching the
       .chip-get idiom used across the portal (green GET, blue path). */
    .endpoint-head { display: block; margin: 28px 0 8px; }
    .endpoint-head .chip-get { font-size: 12.5px; }

    /* Live example links — every one is a real, replayable GET into the API. */
    .live-examples { margin: 4px 0 18px; }
    .live-examples a {
      display: inline-block;
      font-family: var(--font-mono);
      font-size: 11.5px;
      color: var(--blu);
      background: var(--blu-bg);
      border: 1px solid var(--blu-border);
      border-radius: var(--radius-sm);
      padding: 2px 8px;
      margin: 3px 5px 3px 0;
      word-break: break-all;
    }
    .live-examples a:hover { text-decoration: none; border-color: var(--grn-line); }
    .live-examples a::before { content: "GET "; color: var(--grn); }

    /* The evac fail-loud contract gets the loudest chrome on the page. */
    .contract-callout {
      border: 1px solid var(--st-UNAVAILABLE);
      border-left-width: 4px;
      border-radius: var(--radius);
      background: color-mix(in srgb, var(--st-UNAVAILABLE) 7%, var(--bg-card));
      padding: 18px 22px;
      margin: 16px 0 24px;
    }
    .contract-callout > h2:first-child { margin-top: 0; }
    .contract-callout .invariant {
      font-family: var(--font-mono);
      font-weight: 700;
      color: var(--text-hi);
      font-size: 16px;
      letter-spacing: 0.01em;
      margin: 6px 0 12px;
    }

    /* Section heads carry the same 3px rule as .numbered-head / .section-head
       elsewhere. Without it the reference reads as a narrow ragged column
       stranded in white space; the rule spans the full column, so the measured
       prose beneath it looks deliberate rather than orphaned — and the page
       gets the same structural device as every other screen. */
    main > section > h2 {
      border-bottom: 3px solid var(--rule-strong);
      padding-bottom: 7px;
      margin-bottom: 16px;
    }
    /* Sub-heads get the hairline, one weight down. */
    main > section h3 {
      border-bottom: 1px solid var(--rule);
      padding-bottom: 5px;
      margin-bottom: 12px;
    }
    /* …except where a heading introduces a JS-built block that draws its own
       frame, or sits inside a callout. */
    .contract-callout h3, .ep h3 { border-bottom: none; padding-bottom: 0; }

    /* Clears the sticky on-this-page rail (~37px), not a header row — the
       context bar it used to also clear no longer exists. */
    section[id] { scroll-margin-top: 52px; }
    .backtop {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--text-dim);
    }

    /* Reference tables: app.css sets .data-table to white-space:nowrap, which
       blows wide tables out. Here every cell wraps except the leading name
       column and the headers, so all tables read as calm, content-fit blocks
       with one consistent shape (short left columns, a wrapping description). */
    .data-table td { white-space: normal; vertical-align: top; line-height: 1.5; }
    .data-table td:first-child { white-space: nowrap; }
    .data-table th { white-space: nowrap; }
    .data-table td.num { white-space: nowrap; }

    /* ---- Endpoint reference (built by pages/docs.js from spec.js) ---- */
    .ep-list { border-top: 1px solid var(--rule); margin-top: 14px; }
    .ep { border-bottom: 1px solid var(--rule); }
    .ep-head {
      display: grid; grid-template-columns: 40px minmax(0, 1fr) 22px;
      grid-template-areas: "method path mark" ". blurb .";
      gap: 2px 10px; width: 100%; text-align: left; align-items: baseline;
      background: transparent; border: none; padding: 13px 0; cursor: pointer;
    }
    .ep-head:hover { background: var(--paper-sunken); }
    .ep-method { grid-area: method; font-family: var(--font-mono); font-size: 9.5px; font-weight: 700; letter-spacing: 0.08em; color: var(--signal); }
    .ep-path { grid-area: path; font-family: var(--font-mono); font-size: clamp(12px, 1.5vw, 14.5px); color: var(--text-primary); word-break: break-all; }
    .ep-blurb { grid-area: blurb; font-family: var(--font-sans); font-size: 14px; color: var(--text-muted-p); line-height: 1.45; }
    .ep-mark { grid-area: mark; font-family: var(--font-mono); font-size: 14px; color: var(--text-tertiary); text-align: right; }
    .ep.open .ep-mark { color: var(--signal); }
    .ep-body { padding: 0 0 18px; }
    .ep-detail { max-width: var(--measure); font-size: 13.5px; line-height: 1.55; color: var(--text-2nd); }
    .ep-params th { border-bottom: 2px solid var(--rule-strong); }
    .ep-param-name { font-family: var(--font-mono); font-size: 12.5px; color: var(--signal); }
    .ep-examples { margin-top: 14px; }
    .ep-ex-label { font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-tertiary); margin-bottom: 6px; }
    .ep-ex { display: flex; align-items: baseline; gap: 10px; padding: 3px 0; }
    .ep-run {
      flex: none; font-family: var(--font-mono); font-size: 9.5px; font-weight: 700;
      letter-spacing: 0.1em; padding: 3px 9px; border: 1px solid var(--ink);
      background: var(--ink); color: var(--paper); cursor: pointer;
    }
    .ep-run:hover { background: var(--signal); border-color: var(--signal); color: #fff; }
    .ep-ex-url { font-family: var(--font-mono); font-size: 11.5px; color: var(--text-muted-p); word-break: break-all; }
    .ep-pane { margin-top: 12px; }

    /* ---- Envelope beside a live record ---- */
    .env-live { margin: 12px 0 26px; }
    .env-bar {
      display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
      background: var(--ink); color: var(--on-ink-2);
      font-family: var(--font-mono); font-size: 10.5px; padding: 8px 12px;
    }
    .env-bar-id { min-width: 0; overflow-wrap: anywhere; }
    .env-bar .copy-btn { margin-left: auto; border-color: var(--ink-rule); color: var(--on-ink-muted); }
    .env-bar .copy-btn:hover { border-color: var(--on-ink-muted); color: var(--on-ink); }
    .env-rows { border-top: 1px solid var(--rule); }
    .env-live .env-row { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 2px 28px; align-items: start; }
    .env-field { font-family: var(--font-mono); font-size: 13px; font-weight: 600; color: var(--text-primary); }
    .env-type { font-family: var(--font-mono); font-size: 10.5px; color: var(--text-faint-p); }
    .env-live .env-doc { font-size: 13.5px; }
    .env-live .env-val {
      background: var(--paper-sunken); box-shadow: inset 3px 0 0 var(--ink);
      padding: 6px 10px; font-size: 12px; max-height: 16em; overflow: auto;
    }
    @media (max-width: 700px) {
      .env-live .env-row { grid-template-columns: 1fr; gap: 6px; }
      .ep-head { grid-template-columns: 36px minmax(0, 1fr) 20px; }
    }

    /* ---- On-this-page rail ----
       A STICKY HORIZONTAL STRIP, not a fixed side rail. The obvious design is a
       rail in the right gutter, but the gutter only exists above a ~1950px
       viewport (244px sidebar + 1280px column + 2x214px); below that a fixed
       rail positioned from the column edge paints on top of the reference text.
       A sticky strip works at every width and cannot overlap anything. */
    #docs-rail {
      position: sticky; top: 0; z-index: 20;
      background: var(--paper); border-bottom: 1px solid var(--rule);
      padding: 9px 0 8px; margin-bottom: 8px;
      display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap;
      font-family: var(--font-mono); font-size: 10.5px;
    }
    #docs-rail:empty { display: none; }
    .rail-label {
      font-size: 9px; letter-spacing: 0.16em; text-transform: uppercase;
      color: var(--text-tertiary); flex: none;
    }
    .rail-list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 14px; }
    .rail-list a { color: var(--text-muted-p); text-decoration: none; }
    .rail-list a:hover { color: var(--signal); text-decoration: underline; }
    @media (max-width: 900px) {
      /* NOT sticky on a phone. The rail wraps to four lines at 390px, and
         pinning that under the top bar would permanently occupy ~20% of the
         viewport while reading. It stays as a plain table of contents at the
         head of the document, which is what it is useful as on a small screen. */
      #docs-rail { position: static; padding-top: 4px; margin-bottom: 14px; }
    }
  </style>

  <nav id="docs-rail" aria-label="On this page"></nav>
  <Fragment set:html={docsBody} />

  <script is:inline type="module" src="/assets/pages/docs.js"></script>
</Shell>
