---
import Shell from '../layouts/Shell.astro';
import EventDetailStyles from '../components/EventDetailStyles.astro';
---
<Shell
  current="events"
  title="Event · The Grid"
  description="Everything the store holds for one event: the full protojson envelope and typed detail from GET /api/v1/events/{id}, geometry on a map, provenance, the AI enhancement shown beside the verbatim original it was built from, and the complete revision timeline with client-side field diffs from GET /api/v1/events/{id}/history."
>
  <EventDetailStyles slot="head" />

  <p class="crumb-back muted small mono"><a href="/events">&larr; events explorer</a></p>

  <!-- No standfirst. This is a permalink: a reader arrives having already chosen
       a record, so the page owes them the record, not a paragraph about the
       page. What the pane is built from is stated exactly by the two GET lines
       at its foot, which is a better explanation than prose. -->

  <!-- The whole record is built by renderEventDetail() (event-detail.js), the
       SAME renderer the /events browser mounts in its right-hand column — so the
       two screens cannot drift. This page supplies only the container. -->
  <div id="ed-root" style="margin-top:22px;"></div>

  <script is:inline src="/lib/maplibre-gl.js"></script>
  <script is:inline type="module">
    import { initEventPage } from '/assets/pages/event-detail.js';
    initEventPage();
  </script>
</Shell>
