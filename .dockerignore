# Build artifacts
bin/
*.log
*.pid
server

# The site build. site/dist is produced by the site-builder stage and copied
# into the Go stage with COPY --from, so a locally-built (possibly stale) copy
# must never enter the build context. node_modules is excluded for the same
# reason it's git-ignored — and because web/node_modules is a SYMLINK to an
# off-mount store on the dev container, which COPY cannot follow.
site/dist/
web/node_modules
web/.astro/
web/screenshots/out/
tools/screenshots/out/

# Test data and development files
tests/testdata/
memory/
.private-journal/

# Git and editor files
.git/
.gitignore
*.swp
*.swo
*~

# Documentation and specs (not needed in container)
specs/
README.md
ARCHITECTURE.md

# Environment and configuration
.envrc
.env
.env.local

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE files
.vscode/
.idea/
*.iml

# Scripts (not needed in runtime)
scripts/

# Temporary files
tmp/
temp/

# Claude specific
.claude/
CLAUDE.md