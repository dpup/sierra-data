        <div class="iw-header-left">
            <img class="iw-icon" src="https://quickmap.dot.ca.gov/img/cc32x32.png" />
            Chain Control
        </div>
    </div>

    <div class="iw-body">
        <h2 class="iw-title">Westbound US 50</h2>
        
        <p class="iw-text"><strong>Chain Control level HT</strong></p>
        <p class="iw-text"><strong>Location: </strong>Meyers</p>
        <p class="iw-text">All traffic is being held at the chain control check point due to incidents or weather related conditions.</p>
        <p class="iw-text"><strong>Effective from: </strong>11/13/2026 17:25</p>
        <div font-size:xx-small;'>District: 3 Message ID: 9014</div>
        
        <p class="iw-attribution">
            Information courtesy of <strong>Caltrans</strong>
        </p>
    </div>

    <div class="iw-footer">
        <span class="iw-timestamp">Last updated: <strong>11/13/2026</strong> 5:38pm</span>
    </div>
</div>]]></description>
