        <Placemark>
            <name></name>
            <description><![CDATA[<link rel="stylesheet" type="text/css" href="https://quickmap.dot.ca.gov/css/gm-infowindow.css?v=9" />
<div class="infowindow-content">
    <div class="iw-header">
        <div class="iw-header-left">
            <img class="iw-icon" src="https://quickmap.dot.ca.gov/img/cc32x32.png" />
            Chain Control
        </div>
    </div>

    <div class="iw-body">
        <h2 class="iw-title">Eastbound Highway 20</h2>
        
        <p class="iw-text"><strong>Chain Control level TS</strong></p>
        <p class="iw-text"><strong>Location: </strong>Nevada St. - Nevada City</p>
        <p class="iw-text">All trucks must stop at the chain check point, Caltrans is currently screening for chains. Drivers must have maximum chains in their possession in order to proceed. Trucks without chains will be turned around. Permit loads are prohibited over the summit.</p>
        <p class="iw-text"><strong>Effective from: </strong>11/13/2026 12:43</p>
        <div font-size:xx-small;'>District: 3 Message ID: 8949</div>
        
        <p class="iw-attribution">
            Information courtesy of <strong>Caltrans</strong>
        </p>
    </div>

    <div class="iw-footer">
        <span class="iw-timestamp">Last updated: <strong>11/13/2026</strong> 1:37pm</span>
    </div>
</div>]]></description>
